# Copy to .env and adjust:  cp .env.example .env

# Port inside the container (usually no need to change)
PORT=3000
HOST=0.0.0.0

# Max upload size, MB (nginx client_max_body_size must be >= this)
MAX_FILE_SIZE_MB=300

# Allowed video formats (comma-separated). Whisper+ffmpeg read almost anything;
# the burn step always outputs .mp4 (H.264/AAC) so results play everywhere.
ALLOWED_EXTENSIONS=.mp4,.mov,.m4v,.avi,.mkv,.webm,.flv,.wmv,.3gp,.ts,.mpeg,.mpg,.ogv,.mts

# Max size of an edited subtitle file submitted from the editor, KB
MAX_SRT_SIZE_KB=2048

# How long to keep files (video, srt, final output), hours
FILE_TTL_HOURS=24

# Cleanup frequency, minutes
CLEANUP_INTERVAL_MIN=60

# Processing time limit per job, ms (default 4h; 0 = unlimited).
# Applies to both transcription and burning.
SCRIPT_TIMEOUT_MS=14400000

# Script paths inside the container
TRANSCRIBE_SCRIPT=/app/scripts/transcribe.sh
BURN_SCRIPT=/app/scripts/burn.sh

# --- Support / donation link on the final screen ---
# Leave SUPPORT_URL empty to hide the block entirely.
SUPPORT_URL=https://www.buymeacoffee.com/yourname
SUPPORT_LINK_NAME=Buy me a coffee

# --- Limits & licensing ---
# Maximum allowed video duration, seconds (7 minutes)
MAX_VIDEO_DURATION_SEC=420
# Files larger than this (MB) are compressed before transcription
COMPRESS_THRESHOLD_MB=15
# Compression target size, MB (keep a margin below the threshold)
COMPRESS_TARGET_MB=14
# Free translations per IP per day
DAILY_LIMIT=3
# License key that lifts the limit. CHANGE THIS before going live!
LICENSE_KEY=SUBS-7K2M-X9QF-4T8B-WL3D
# License cookie lifetime, days
LICENSE_TTL_DAYS=7
# Telegram contact for obtaining a license key
TG_CONTACT=@it_link_a

# --- Legal identity for Impressum / Datenschutz (.de requirement) ---
# These appear on /impressum.html and /datenschutz.html. FILL BEFORE GOING LIVE.
LEGAL_NAME=
LEGAL_STREET=
LEGAL_ZIP_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
# Optional:
LEGAL_PHONE=
LEGAL_VAT_ID=
# Responsible per § 18 Abs. 2 MStV (leave empty to reuse LEGAL_NAME):
LEGAL_RESPONSIBLE=

# Public origin for Next.js canonical links and sitemap (e.g. https://your.domain.com).
# Leave empty locally; no production domain is guessed.
SITE_URL=
